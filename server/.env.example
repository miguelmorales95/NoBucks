# NoBucks API environment — copy to .env and fill in

# --- Core ---
PORT=4000
# CORS: your web app's origin (the Vite app / CloudFront URL). Use * only in dev.
CORS_ORIGIN=http://localhost:5173

# --- Auth ---
# Long random string. In production store this in AWS Secrets Manager / SSM Parameter Store.
JWT_SECRET=change-me-to-a-long-random-string

# --- Database (Amazon RDS / Aurora Serverless v2 for PostgreSQL) ---
# Format: postgresql://USER:PASSWORD@HOST:5432/nobucks?schema=public&sslmode=require
DATABASE_URL=postgresql://nobucks:password@localhost:5432/nobucks?schema=public

# --- AWS ---
AWS_REGION=us-west-2
# S3 bucket for listing/profile photos (private; served via presigned URLs or CloudFront).
S3_BUCKET=nobucks-uploads
# Optional: SNS platform application ARN for mobile push (or leave blank to no-op).
SNS_PLATFORM_APP_ARN=

# When running on ECS/App Runner with a task role, leave AWS keys unset and use the role.
# For local dev only:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Cognito (optional, for hosted social sign-in: Google / Apple / Facebook) ---
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=us-west-2
